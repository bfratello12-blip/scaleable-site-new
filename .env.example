# ---------------------------------------------------------------------------
# ScaleAble website environment variables
# Copy to `.env.local` for local development, or set in the Vercel dashboard.
# ---------------------------------------------------------------------------

# Canonical production origin (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://scaleable.com

# Scheduling link used by every "Book a Call" CTA across the site.
# Leave blank to use the default: https://calendar.app.google/DipKGPYwU4EP6HK97
NEXT_PUBLIC_BOOK_CALL_URL=

# Resend API key used by the server-side lead form handler (/api/lead).
# Never expose this to the browser.
RESEND_API_KEY=

# Reddit Conversions API access token. SERVER ONLY — must never be given a
# NEXT_PUBLIC_ prefix. Generated by a Reddit Ads business admin
# (Events Manager -> Conversions API). While empty, pixel events still fire and
# server-side CAPI forwarding is skipped.
REDDIT_CAPI_ACCESS_TOKEN=

# Optional. Overrides the Reddit CAPI endpoint, for pointing local or staging
# environments at a mock. Leave empty in production.
REDDIT_CAPI_ENDPOINT=

# Optional overrides for the transactional sender + destination.
# LEAD_FROM_EMAIL must be a verified domain/sender inside Resend.
LEAD_FROM_EMAIL="ScaleAble Website <website@scaleableapp.com>"
LEAD_TO_EMAIL=hello@scaleableapp.com

# ---------------------------------------------------------------------------
# Analytics placeholders — leave blank until real IDs are issued.
# No script is injected while a value is empty.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Reddit defaults to the live pixel ID in code. Set this only to override it.
NEXT_PUBLIC_REDDIT_PIXEL_ID=
